# Copy to .env for local development. On Render, set these in the dashboard instead.
NODE_ENV=development
PORT=5000

# Your Supabase project URL and PUBLIC anon/publishable key (Dashboard -> Project Settings -> API).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Backend-only, bypasses Row Level Security. OPTIONAL today (no route uses it).
# It is reserved for the Razorpay webhook stage. NEVER put it in frontend/.env or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser origin(s), comma-separated. Production: your Vercel URL, e.g. https://smartcart.vercel.app
FRONTEND_URL=http://localhost:5173
