# Copy to .env — these two values are PUBLIC (safe in the browser). Never put a
# service_role key, Razorpay secret or any other secret in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Express API (backend/). Dev: http://localhost:5000 - Prod: your Render URL, e.g. https://smartcart-api.onrender.com
VITE_API_URL=http://localhost:5000
